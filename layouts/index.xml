{{- $pages := where .Site.RegularPages "Section" "in" (slice "posts" "til") -}}
{{- $pages = where $pages "Params.hidden" "ne" true -}}
{{- $pages = $pages.ByDate.Reverse -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ .Site.Title }}</title>
  <link>{{ .Site.BaseURL }}</link>
  <description>{{ .Site.Params.subtitle }}</description>
  <generator>Hugo</generator>
  <language>{{ .Site.LanguageCode }}</language>
  {{ with .Site.Copyright }}<copyright>{{ . }}</copyright>{{ end }}
  {{ with .OutputFormats.Get "rss" }}<atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />{{ end }}
  {{ range $pages }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <guid>{{ .Permalink }}</guid>
    <description>{{ .Summary | plainify | html }}</description>
  </item>
  {{ end }}
</channel>
</rss>
